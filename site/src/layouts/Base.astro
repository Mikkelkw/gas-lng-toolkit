---
import { NAV, PAGES, SITE_NAME, canonical, type PageMeta } from '../lib/pages';

interface Props {
  page: keyof typeof PAGES;
}
const meta: PageMeta = PAGES[Astro.props.page];
const url = canonical(meta.path);
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#0b5e63" />
    <meta property="og:type" content={Astro.props.page === 'learn' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">{SITE_NAME}</a>
        <nav aria-label="Main">
          <ul>
            {NAV.map((n) => (
              <li><a href={n.path} aria-current={here === n.path ? 'page' : undefined}>{n.nav}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Not investment advice. Data: GIE AGSI+ / ALSI, EIA, ECB, Open-Meteo (CC BY 4.0). Built by Mikkel Wahl.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1a1f24;
    --muted: #5b6670;
    --line: #dde3e8;
    --bg: #ffffff;
    --panel: #f5f7f8;
    --accent: #0b5e63;
    --accent-soft: #e3f0f0;
    --warn: #9a3412;
    --font: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; font-family: var(--font); color: var(--ink); background: var(--bg); line-height: 1.5; font-size: 16px; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.25; }
  h1 { font-size: 1.75rem; margin: 1.5rem 0 0.5rem; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--bg); padding: 8px; z-index: 10; }
  .site-header { border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding-top: 12px; padding-bottom: 12px; }
  .brand { font-weight: 700; color: var(--ink); text-decoration: none; }
  .site-header nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0; padding: 0; }
  .site-header nav a { text-decoration: none; color: var(--muted); padding: 4px 0; display: inline-block; }
  .site-header nav a:hover, .site-header nav a[aria-current='page'] { color: var(--accent); }
  .site-header nav a[aria-current='page'] { border-bottom: 2px solid var(--accent); }
  main { min-height: 60vh; padding-bottom: 48px; }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.875rem; padding: 16px 0; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .muted { color: var(--muted); }
</style>
