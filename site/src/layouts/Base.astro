---
import { NAV, PAGES, SITE_NAME, canonical, type PageMeta } from '../lib/pages';
// Self-hosted fonts (Fontsource, latin subset only). No external font CDN.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import interUrl from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import frauncesUrl from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import CompassMark from '../components/CompassMark.astro';

interface Props {
  page: keyof typeof PAGES;
  /** Full-bleed page: sections set their own width (landing page). */
  full?: boolean;
}
const meta: PageMeta = PAGES[Astro.props.page];
const url = canonical(meta.path);
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={url} />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#0B1F33" />
    <meta property="og:type" content={Astro.props.page === 'learn' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header dark">
      <div class="wrap header-inner">
        <a class="brand" href="/"><CompassMark size={22} /><span>{SITE_NAME}</span></a>
        <nav aria-label="Main">
          <ul>
            {NAV.map((n) => (
              <li><a href={n.path} aria-current={here === n.path ? 'page' : undefined}>{n.nav}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class={Astro.props.full ? 'full' : 'wrap'}>
      <slot />
    </main>
    <footer class="site-footer dark">
      <div class="wrap">
        <p>Not investment advice. Data: GIE AGSI+ / ALSI, EIA, ECB, Open-Meteo (CC BY 4.0). Built by Mikkel Wahl.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* "Maritime chart room" palette (SPEC 11.1). Contrast checked: see DECISIONS.md. */
  :root {
    --navy: #0b1f33;
    --ocean: #12355b;
    --paper: #f4f1ea;
    --ink: #1b2733;
    --brass: #c8a24a;
    --teal: #2a9d8f;
    --signal: #c0392b;

    --muted: #4e5a66; /* 6.3:1 on paper */
    --line: #dcd5c6;
    --panel: #fbf9f4;
    --card: #fffdf8;
    --link: var(--ocean); /* 11:1 on paper */
    --teal-soft: #e1ede9;
    --on-dark: #f4f1ea;
    --on-dark-muted: #b8c4d0; /* 9.4:1 on navy */

    /* Older names used across the tool styles. */
    --accent: var(--ocean);
    --accent-soft: var(--teal-soft);
    --warn: var(--signal);
    --bg: var(--paper);

    --serif: 'Fraunces', Georgia, 'Times New Roman', serif;
    --sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Consolas, monospace;
    --font: var(--sans);
    --graticule: linear-gradient(rgba(200, 162, 74, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(200, 162, 74, 0.07) 1px, transparent 1px);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; font-family: var(--sans); color: var(--ink); background: var(--paper); line-height: 1.5; font-size: 16px; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  a { color: var(--link); text-decoration-color: rgba(200, 162, 74, 0.9); text-underline-offset: 3px; text-decoration-thickness: 1.5px; }
  a:hover { text-decoration-color: var(--ink); }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.2; color: var(--navy); letter-spacing: -0.005em; }
  h1 { font-size: 2rem; margin: 1.5rem 0 0.5rem; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--paper); color: var(--ink); padding: 8px; z-index: 10; }
  :focus-visible { outline: 3px solid var(--ocean); outline-offset: 2px; }
  .dark :focus-visible { outline-color: var(--brass); }
  .muted { color: var(--muted); }
  input[type='number'], input[type='date'], output, code, td.num, .figure { font-family: var(--mono); }

  /* Dark sections: navy with a faint chart grid. */
  .dark { background-color: var(--navy); background-image: var(--graticule); background-size: 48px 48px; color: var(--on-dark); }
  .dark a { color: var(--on-dark); }

  .site-header { border-bottom: 2px solid var(--brass); }
  .header-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; padding-top: 12px; padding-bottom: 12px; }
  .brand { display: inline-flex; align-items: center; gap: 8px; font-family: var(--serif); font-weight: 600; font-size: 1.15rem; text-decoration: none; color: var(--on-dark); }
  .site-header nav ul { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 18px; margin: 0; padding: 0; }
  .site-header nav a { text-decoration: none; color: var(--on-dark-muted); padding: 4px 0; display: inline-block; font-size: 0.95rem; border-bottom: 2px solid transparent; }
  .site-header nav a:hover { color: var(--on-dark); }
  .site-header nav a[aria-current='page'] { color: var(--on-dark); border-bottom-color: var(--brass); }

  main.wrap { min-height: 60vh; padding-bottom: 48px; }
  .site-footer { border-top: 2px solid var(--brass); color: var(--on-dark-muted); font-size: 0.875rem; padding: 18px 0; }
  .site-footer p { margin: 0; }

  /* Thin brass rule for section dividers. */
  .rule { border: 0; height: 1px; background: var(--brass); margin: 0; }
</style>
