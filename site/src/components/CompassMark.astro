---
/** Minimal compass mark for the logo. Decorative: the site name sits beside it. */
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <circle cx="16" cy="16" r="14" fill="none" stroke="#C8A24A" stroke-width="1.5" />
  <path d="M16 3 19 16 16 29 13 16Z" fill="#C8A24A" />
  <path d="M3 16 16 13 29 16 16 19Z" fill="#F4F1EA" opacity="0.85" />
  <circle cx="16" cy="16" r="1.8" fill="#0B1F33" />
</svg>
